# ============================================================
# pyffeine-hosting - environment variables template
#
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file - it is gitignored.
# Keep each value on a single line (no line wrapping).
# ============================================================

# --- Cloudflare Tunnel --------------------------------------
# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel
# Production:
CLOUDFLARED_TOKEN=replace-with-your-tunnel-token
# Development (separate tunnel):
# CLOUDFLARED_TOKEN=replace-with-your-dev-tunnel-token

# --- OpenWebUI ----------------------------------------------
# Production:
WEBUI_URL=https://gpt.pyffeine.top
CORS_ALLOW_ORIGIN=https://gpt.pyffeine.top
# Development (different hostname):
# WEBUI_URL=https://dev-gpt.pyffeine.top
# CORS_ALLOW_ORIGIN=https://dev-gpt.pyffeine.top

WEBUI_SECRET_KEY=replace-with-a-long-random-string
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_API_BASE_URL=https://api.openai.com/v1

# --- Docker Compose / Environment ---------------------------
# Select the pre-existing external Docker volume.
# Production:
OPENWEBUI_VOLUME_NAME=open_webui_data
# Development:
# OPENWEBUI_VOLUME_NAME=open_webui_data_dev

# --- Milvus ---------------------------------------------------
# Runs inside this Compose project; no host port is published.
# OpenWebUI connects to http://milvus:19530 on the internal network.
# Milvus, etcd, and MinIO data are stored in Compose-managed volumes.
